---
import { useTranslations, type Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const stats = [
  { value: t('about.stat1.value') as string, label: t('about.stat1.label') as string },
  { value: t('about.stat2.value') as string, label: t('about.stat2.label') as string },
  { value: t('about.stat3.value') as string, label: t('about.stat3.label') as string },
  { value: t('about.stat4.value') as string, label: t('about.stat4.label') as string },
];

const philosophyItems = t('philosophy.items') as string[];
---

<section id="about" class="relative py-24 px-6 overflow-hidden">
  <div class="orb w-72 h-72 bg-blue-700 top-0 right-0 opacity-15"></div>

  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-cyan-400 text-sm font-semibold tracking-widest uppercase mb-3">{t('about.eyebrow') as string}</p>
      <h2 class="section-title">{t('about.title') as string} <span class="gradient-text">{t('about.title.hl') as string}</span></h2>
      <div class="w-16 h-1 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full mx-auto mt-4"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Avatar -->
      <div class="flex justify-center md:justify-start">
        <div class="relative">
          <div class="absolute -inset-4 blob opacity-30" style="background: linear-gradient(135deg, #0891b2, #2563eb);"></div>
          <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-3xl glass overflow-hidden border border-white/15 flex items-center justify-center">
            <div class="text-center text-white/30">
              <svg class="w-24 h-24 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <p class="text-sm">Your Photo Here</p>
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 glass px-4 py-2 rounded-xl border border-white/15 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-sm font-medium">{t('about.badge') as string}</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="space-y-5">
        <h3 class="font-display text-2xl font-bold">
          <span class="gradient-text">{t('about.role') as string}</span>
        </h3>

        <p class="text-white/60 leading-relaxed">{t('about.p1') as string}</p>
        <p class="text-white/60 leading-relaxed">{t('about.p2') as string}</p>
        <p class="text-white/60 leading-relaxed">{t('about.p3') as string}</p>
        <p class="text-white/60 leading-relaxed">{t('about.p4') as string}</p>

        <!-- Philosophy callout -->
        <div class="glass rounded-2xl p-5 border border-cyan-500/15 mt-6">
          <p class="text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-3">{t('philosophy.title') as string}</p>
          <p class="text-white/55 text-sm mb-3">{t('philosophy.intro') as string}</p>
          <ul class="space-y-1.5">
            {philosophyItems.map(item => (
              <li class="flex items-center gap-2 text-sm text-white/70">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- CTAs -->
        <div class="flex gap-4 pt-2">
          <a href="#contact" class="btn-primary">
            <span>{t('about.cta.talk') as string}</span>
          </a>
          <a href="/cv.pdf" download class="btn-outline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {t('about.cta.cv') as string}
          </a>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16">
      {stats.map((stat) => (
        <div class="glass-hover rounded-2xl p-6 text-center">
          <p class="font-display text-3xl font-bold gradient-text mb-1">{stat.value}</p>
          <p class="text-white/50 text-sm">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
