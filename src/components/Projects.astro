---
import { useTranslations, type Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// TODO: Replace these 3 entries with your real projects.
// Each project has: title, description (bilingual), tags, color, liveUrl, githubUrl, featured.
const projects = [
  {
    title: lang === 'es' ? 'Proyecto 1' : 'Project 1',
    description: lang === 'es'
      ? 'Descripción del proyecto. Contá qué problema resolvía, las decisiones técnicas clave y el impacto.'
      : 'Project description. Explain what problem it solved, key technical decisions, and the impact.',
    tags: ['React', 'TypeScript'],
    color: 'from-cyan-600 to-blue-800',
    liveUrl: null,
    githubUrl: 'https://github.com/ivancuestas',
    featured: true,
  },
  {
    title: lang === 'es' ? 'Proyecto 2' : 'Project 2',
    description: lang === 'es'
      ? 'Descripción del proyecto. Contá qué problema resolvía, las decisiones técnicas clave y el impacto.'
      : 'Project description. Explain what problem it solved, key technical decisions, and the impact.',
    tags: ['React', 'TypeScript'],
    color: 'from-blue-600 to-sky-800',
    liveUrl: null,
    githubUrl: 'https://github.com/ivancuestas',
    featured: true,
  },
  {
    title: lang === 'es' ? 'Proyecto 3' : 'Project 3',
    description: lang === 'es'
      ? 'Descripción del proyecto. Contá qué problema resolvía, las decisiones técnicas clave y el impacto.'
      : 'Project description. Explain what problem it solved, key technical decisions, and the impact.',
    tags: ['React', 'TypeScript'],
    color: 'from-sky-600 to-cyan-800',
    liveUrl: null,
    githubUrl: 'https://github.com/ivancuestas',
    featured: false,
  },
];
---

<section id="projects" class="relative py-24 px-6 overflow-hidden">
  <div class="orb w-80 h-80 bg-blue-600 bottom-10 -left-20 opacity-15"></div>

  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-cyan-400 text-sm font-semibold tracking-widest uppercase mb-3">{t('projects.eyebrow') as string}</p>
      <h2 class="section-title">{t('projects.title') as string} <span class="gradient-text">{t('projects.title.hl') as string}</span></h2>
      <div class="w-16 h-1 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full mx-auto mt-4"></div>
      <p class="text-white/50 max-w-xl mx-auto mt-6">{t('projects.subtitle') as string}</p>
    </div>

    <!-- Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="glass-hover rounded-2xl overflow-hidden flex flex-col">
          <!-- Color banner -->
          <div class={`h-44 bg-gradient-to-br ${project.color} relative flex items-center justify-center flex-shrink-0`}>
            <div class="absolute inset-0 opacity-20"
              style="background-image:radial-gradient(circle at 30% 50%, rgba(255,255,255,0.3) 0%, transparent 60%);">
            </div>
            <svg class="w-12 h-12 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            {project.featured && (
              <span class="absolute top-3 right-3 text-xs bg-white/20 backdrop-blur-sm px-2 py-1 rounded-full font-medium">
                {t('projects.featured') as string}
              </span>
            )}
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="font-display font-bold text-lg mb-2">{project.title}</h3>
            <p class="text-white/50 text-sm leading-relaxed mb-4 flex-grow">{project.description}</p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {project.tags.map((tag) => (
                <span class="text-xs px-2.5 py-1 rounded-lg glass text-white/60 border border-white/8">{tag}</span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex gap-3 mt-auto">
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener"
                  class="flex items-center gap-1.5 text-sm font-medium text-cyan-400 hover:text-cyan-300 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  {t('projects.live') as string}
                </a>
              )}
              <a href={project.githubUrl} target="_blank" rel="noopener"
                class="flex items-center gap-1.5 text-sm font-medium text-white/50 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                {t('projects.source') as string}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- More -->
    <div class="text-center mt-12">
      <a href="https://github.com" target="_blank" rel="noopener" class="btn-outline inline-flex">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        {t('projects.more') as string}
      </a>
    </div>
  </div>
</section>
