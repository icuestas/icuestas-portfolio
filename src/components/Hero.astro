---
import { useTranslations, type Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden px-6 pt-24 pb-16">

  <!-- Background orbs -->
  <div class="orb w-96 h-96 bg-cyan-600   top-10 -left-20"        style="animation: float 8s  ease-in-out infinite;"></div>
  <div class="orb w-80 h-80 bg-blue-600   bottom-20 -right-16"    style="animation: float 10s ease-in-out infinite reverse;"></div>
  <div class="orb w-64 h-64 bg-sky-500    top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" style="animation: float 12s ease-in-out infinite 2s;"></div>

  <!-- Grid pattern -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"
  ></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center">

    <!-- Availability badge -->
    <div class="inline-flex items-center gap-2 glass px-4 py-2 rounded-full text-sm text-white/70 mb-8 animate-fade-in">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      {t('hero.badge') as string}
    </div>

    <!-- Heading -->
    <h1
      class="font-display text-5xl md:text-7xl font-extrabold leading-tight mb-4 animate-slide-up"
      style="animation-delay:0.1s;opacity:0;animation-fill-mode:forwards;"
    >
      {t('hero.title') as string}
    </h1>

    <!-- Subtitle -->
    <p
      class="font-display text-2xl md:text-3xl font-semibold gradient-text mb-6 animate-slide-up"
      style="animation-delay:0.2s;opacity:0;animation-fill-mode:forwards;"
    >
      {t('hero.subtitle') as string}
    </p>

    <!-- Description -->
    <p
      class="text-white/55 max-w-2xl mx-auto mb-10 leading-relaxed text-lg animate-slide-up"
      style="animation-delay:0.3s;opacity:0;animation-fill-mode:forwards;"
    >
      {t('hero.description') as string}
    </p>

    <!-- CTAs -->
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up"
      style="animation-delay:0.4s;opacity:0;animation-fill-mode:forwards;"
    >
      <a href="#projects" class="btn-primary px-8 py-4 text-base">
        <span>{t('hero.cta.work') as string}</span>
        <svg class="w-4 h-4 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <a href="#contact" class="btn-outline px-8 py-4 text-base">
        {t('hero.cta.contact') as string}
      </a>
    </div>

    <!-- Social links -->
    <div
      class="flex items-center justify-center gap-4 mt-12 animate-slide-up"
      style="animation-delay:0.5s;opacity:0;animation-fill-mode:forwards;"
    >
      <a href="https://github.com" target="_blank" rel="noopener" aria-label="GitHub"
        class="glass p-3 rounded-xl text-white/50 hover:text-white transition-all duration-200 hover:-translate-y-1">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn"
        class="glass p-3 rounded-xl text-white/50 hover:text-white transition-all duration-200 hover:-translate-y-1">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30 animate-bounce">
    <span class="text-xs tracking-widest uppercase">{t('hero.scroll') as string}</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
